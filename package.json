{
  "name": "skyclip",
  "private": true,
  "type": "module",
  "scripts": {
    "start": "node server.mjs",
    "start:stable": "powershell -NoProfile -ExecutionPolicy Bypass -File scripts/start-skyclip.ps1",
    "start:api": "node server.mjs",
    "qa": "npm run check && npm run verify",
    "qa:full": "npm run qa && npm run verify:api && npm run verify:media && npm run verify:stt && npm run verify:highlight && npm run verify:auth && npm run verify:storage",
    "check": "node --check app.js && node --check server.mjs && node --check render.mjs",
    "render": "node render.mjs",
    "verify": "node verify.mjs",
    "verify:api": "node verify-api.mjs",
    "verify:media": "node verify-media.mjs",
    "verify:stt": "node verify-stt.mjs",
    "verify:highlight": "node verify-highlight.mjs",
    "verify:auth": "node verify-auth.mjs",
    "verify:storage": "node verify-storage.mjs"
    ,"verify:ready": "node verify-ready.mjs"
    ,"verify:config": "node verify-config.mjs"
    ,"verify:prompt": "node verify-prompt.mjs"
  }
}
