# Optional external analysis provider. Keep local fallback when unset.
SKYCLIP_ANALYSIS_PROVIDER=local

# Optional STT gateway. The gateway should accept multipart/form-data with a `file` field
# and return { "captions": ["..."], "captionCues": [{"start":0,"end":3}] }.
# SKYCLIP_STT_URL=https://your-stt-gateway.example/transcribe
# SKYCLIP_STT_TOKEN=replace-with-gateway-token
# SKYCLIP_STT_TIMEOUT_MS=120000

# Optional server port and isolated persistence file.
# PORT=8787
# SKYCLIP_DATA_FILE=./skyclip-data.json
